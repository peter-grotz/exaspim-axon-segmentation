#!/usr/bin/env bash
# Generated by scripts/sync_capsule.py from capsule/environment/postInstall.in — do not edit here.
set -euxo pipefail

export UV_PYTHON_INSTALL_DIR=/opt/python XDG_CACHE_HOME=/opt/cache HF_HOME=/opt/hf-cache
uv venv --python 3.12 /opt/venv

# Exact pins exported from uv.lock at @COMMIT@.
cat > /tmp/requirements.txt <<'REQ'
@REQUIREMENTS@
REQ
uv pip install --python /opt/venv/bin/python --no-cache -r /tmp/requirements.txt
rm /tmp/requirements.txt

# Bake the pretrained weights and the CCF ontology into the image: runs need only S3 access.
/opt/venv/bin/python - <<'PY'
from pathlib import Path

import requests
from huggingface_hub import hf_hub_download

hf_hub_download("@HF_REPO@", "@HF_FILE@", revision="@HF_REVISION@")
ontology = Path("/opt/cache/exaspim-axon/structure_graph_1.json")
ontology.parent.mkdir(parents=True, exist_ok=True)
response = requests.get("@ONTOLOGY_URL@", timeout=120)
response.raise_for_status()
ontology.write_text(response.text)
PY
chmod -R a+rX /opt/cache /opt/hf-cache /opt/venv /opt/python
